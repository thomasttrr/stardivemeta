---
// New characters page (clean guide, 2026-11-24): the current banner,
// what's coming next, the newest characters with their tiers, and
// the debut history. Dates only — no source names, no verdicts.
import Base from '../layouts/Base.astro';
import Medallion from '../components/Medallion.astro';
import {
  banners,
  data,
  displayTier,
  fmtDate,
  upcoming,
} from '../lib/data';

const today = new Date().toISOString().slice(0, 10);

// The newest characters (released within 45 days of the build).
const listed = data.characters.filter((c) => c.is_new);

// The current banner: the banner that started most recently, while it
// has not ended. Several older debut entries have no recorded end date;
// they never count as current once a newer banner has started, and when
// the latest banner has ended there is no current banner to show.
const latestStarted = banners
  .filter((b) => b.start <= today)
  .sort((a, b) => b.start.localeCompare(a.start))[0];
const current =
  latestStarted && (latestStarted.end === null || latestStarted.end >= today)
    ? latestStarted
    : undefined;

// Debut history, newest first.
const debuts = [...banners].sort((a, b) => b.start.localeCompare(a.start));

// What's next: officially announced events whose date has not
// passed yet (data/banners.toml [[upcoming]]). Entries remove
// themselves as their dates pass, so the panel cannot go stale.
const next = upcoming.filter((u) => u.date >= today);
---

<Base description="New MONGIL: STAR DIVE characters, the current banner, and what's coming next." title="New characters – StarDiveMeta" path="/banner/">
  <h1 class="page-title">New characters</h1>
  <p class="built">
    The current banner, what's coming next, and the newest characters.
  </p>

  {
    current && (
      <section class="banner-now">
        <h2>Current banner</h2>
        <p class="banner-line panel-row split vcent" data-panel>
          <span class="who">
            <Medallion id={current.character} name={current.name} />
            <a href={`/c/${current.character}/`}>{current.name}</a>
          </span>
          <span class="dim">
            {fmtDate(current.start)}
            {current.end && ` – ${fmtDate(current.end)}`}
          </span>
        </p>
      </section>
    )
  }

  {
    next.length > 0 && (
      <section>
        <h2>What's next</h2>
        {next.map((u) => (
          <div class="next-item">
            <p class="banner-line panel-row split" data-panel>
              <span class="nm">{u.title}</span>
              <span class="dim">{fmtDate(u.date)}</span>
            </p>
            <p class="rule">{u.note}</p>
          </div>
        ))}
      </section>
    )
  }

  <section>
    <h2>New this version</h2>
    {
      listed.length === 0 ? (
        <p class="empty" data-panel>No new characters right now.</p>
      ) : (
        <ul class="panel-list chars">
          {listed.map((c) => (
            <li class="panel-row split vcent" data-panel>
              <span class="nm who">
                <Medallion id={c.id} name={c.name} />
                {c.name}
              </span>
              <span class="facts">
                Tier {displayTier(c)} ·{' '}
                <a href={`/c/${c.id}/`}>See why</a>
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section>
    <h2>Debut history</h2>
    <ul class="panel-list chars">
      {
        debuts.map((b) => (
          <li class="panel-row split vcent" data-panel>
            <span class="nm who">
              <Medallion id={b.character} name={b.name} />
              <a href={`/c/${b.character}/`}>{b.name}</a>
            </span>
            <span class="facts">
              {b.end
                ? `${fmtDate(b.start)} – ${fmtDate(b.end)}`
                : `From ${fmtDate(b.start)}`}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="rule">
      Each character's tier and the short reason are on their page.
    </p>
  </section>
</Base>

<style>
  .rule {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 6px 0 0;
  }
  .banner-line a {
    color: var(--text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }
  .banner-line .dim {
    color: var(--sub);
    font-size: var(--text-body-sm);
  }
  .chars .nm {
    font-weight: var(--weight-semibold);
  }
  .chars .nm a {
    color: var(--text);
    text-decoration: none;
  }
  .chars .facts {
    color: var(--sub);
    font-size: var(--text-body-sm);
  }
  .chars .facts a {
    color: var(--link);
    white-space: nowrap;
  }
  /* Rows that name a character carry a small round portrait, so the
     row reads as a character and not an empty bar. The size rides in
     on --med, which the medallion inherits. */
  .who {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    --med: 40px;
  }
  .panel-row.split.vcent {
    align-items: center;
  }
  .next-item {
    margin-bottom: 12px;
  }
  .next-item .nm {
    font-weight: var(--weight-semibold);
  }
</style>
