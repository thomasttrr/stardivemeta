---
// Beginner page (clean guide, 2026-11-24; lists computed in
// mongil-core/src/derive.rs and emitted as tierlist.json.derived).
// Per D-3 there is NO reroll section: rarity/pool data is not
// verified, so `derived.beginner.reroll` is null and the section
// below renders only if that ever changes.
import Base from '../layouts/Base.astro';
import CharacterChip from '../components/CharacterChip.astro';
import { charactersById, data, displayTier, tierDisplay } from '../lib/data';

const beginner = data.derived.beginner;
const byId = (id: string) => charactersById.get(id)!;
---

<Base description="New to MONGIL: STAR DIVE? The characters that carry a new account, the ones that repay investment, and answers to common first questions." title="Beginner – StarDiveMeta" path="/beginner/">
  <h1 class="page-title">New players</h1>
  <p class="built">
    Not pull advice — just who carries a new account, and who pays off
    later.
  </p>

  <section>
    <h2>Strong from the start</h2>
    <p class="rule">Top tiers even with little invested. Safe first picks.</p>
    <div class="cards">
      {
        beginner.agreed_low.map((id) => {
          const c = byId(id);
          return <CharacterChip character={c} tier={displayTier(c)} eager />;
        })
      }
    </div>
  </section>

  <section>
    <h2>Get better with investment</h2>
    <p class="rule">These climb as you invest — awakenings and their signature weapon.</p>
    <ul class="panel-list rise">
      {
        beginner.rise.map((r) => (
          <li class="panel-row split" data-panel>
            <a href={`/c/${r.id}/`}>{byId(r.id).name}</a>
            <span class="arrow">
              {tierDisplay(r.low)} → {tierDisplay(r.max)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Worth a second look</h2>
    <p class="rule">
      Strong for some teams and modes, weaker for others. Tap one for
      the short reason.
    </p>
    <div class="cards">
      {
        beginner.contested_low.map((id) => {
          const c = byId(id);
          return <CharacterChip character={c} tier={displayTier(c)} />;
        })
      }
    </div>
  </section>

  {
    beginner.reroll && (
      <section>
        <h2>On the permanent banner and strong at Low</h2>
        <div class="cards">
          {beginner.reroll.map((entry) => {
            const c = byId(entry.id);
            return <CharacterChip character={c} tier={displayTier(c)} />;
          })}
        </div>
      </section>
    )
  }

  <section>
    <h2>Common questions</h2>
    <div class="faq" data-panel>
      <h3>How does rerolling work?</h3>
      <p>
        Rerolling means starting a fresh account, playing the opening
        until pulls unlock, and spending the pulls a new account starts
        with. If the results are not what you wanted, you delete or
        abandon that account and start over. It costs time, not money —
        how long one attempt takes depends on how much of the opening
        can be skipped, which changes with game updates.
      </p>
      <h3>Which character should I reroll for?</h3>
      <p>
        Anyone in "Strong from the start" above. They carry a new
        account without heavy investment, which is what a reroll is
        for.
      </p>
      <h3>I am stuck in the 魑魅魍魎 quest. Is it bugged?</h3>
      <p>
        Players have reported a problem with this quest: being unable
        to leave the spirit world, with the boss unable to be beaten.
        That is a reported issue, not something we have verified
        ourselves, and we do not have a confirmed workaround. Fixes
        for quest bugs arrive in game updates, so check the official
        in-game notices for word of a fix.
      </p>
      <h3>What should a new account do first?</h3>
      <p>
        Finish the opening story until pulls and the permanent banner
        unlock, then redeem any working codes — the{' '}
        <a href="/codes/">Codes page</a> lists what is active right
        now. After that, the sections above show who is strong with
        little invested, which is where a new account plays.
      </p>
    </div>
  </section>

  <p class="built">
    Every pick on this page comes from the same tier list on the home
    page.
  </p>
</Base>

<style>
  .faq {
    border-radius: var(--radius-xl);
    padding: 6px var(--space-panel) 10px;
  }
  .faq h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    margin: 18px 0 0;
  }
  .faq p {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 5px 0 8px;
  }
  .rise a {
    color: var(--text);
    text-decoration: none;
    font-weight: var(--weight-semibold);
  }
  .rise .arrow {
    color: var(--sub);
    font-size: var(--text-body-sm);
    white-space: nowrap;
  }
</style>
