---
// Beginner page (plan T3.7 + §B.5 Beginner; lists computed in
// mongil-core/src/derive.rs and emitted as tierlist.json.derived).
// Per D-3 there is NO reroll section: rarity/pool data is not
// two-source verified, so `derived.beginner.reroll` is null and the
// section below renders only if that ever changes.
import Base from '../layouts/Base.astro';
import CharacterChip from '../components/CharacterChip.astro';
import EvidenceDialogs from '../components/EvidenceDialogs.astro';
import { charactersById, data, tierDisplay } from '../lib/data';

const beginner = data.derived.beginner;
const byId = (id: string) => charactersById.get(id)!;
---

<Base description="What the MONGIL: STAR DIVE tier lists say about characters at low investment. This is not pull advice." title="Beginner – StarDiveMeta" path="/beginner/">
  <h1 class="page-title">New players</h1>
  <p class="built">
    This is not pull advice. It's what the lists say about low investment.
  </p>

  <section>
    <h2>Lists agree these are strong at Low</h2>
    <p class="rule">S or A tier at Low, and the lists agree (Solid).</p>
    <div class="cards">
      {
        beginner.agreed_low.map((id) => {
          const c = byId(id);
          return <CharacterChip character={c} result={c.results.low} />;
        })
      }
    </div>
  </section>

  <section>
    <h2>Get better with investment</h2>
    <p class="rule">Their Max tier is higher than their Low tier.</p>
    <ul class="panel-list rise">
      {
        beginner.rise.map((r) => (
          <li class="panel-row split" data-panel>
            <a href={`/c/${r.id}/`}>{byId(r.id).name}</a>
            <span class="arrow">
              {tierDisplay(r.low)} → {tierDisplay(r.max)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Lists disagree on these at Low</h2>
    <p class="rule">
      Contested at Low. Tap one to see what each list says.
    </p>
    <div class="cards">
      {
        beginner.contested_low.map((id) => {
          const c = byId(id);
          return <CharacterChip character={c} result={c.results.low} />;
        })
      }
    </div>
  </section>

  {
    beginner.reroll && (
      <section>
        <h2>On the permanent banner and strong at Low</h2>
        <div class="cards">
          {beginner.reroll.map((entry) => {
            const c = byId(entry.id);
            return <CharacterChip character={c} result={c.results.low} />;
          })}
        </div>
      </section>
    )
  }

  <section>
    <h2>Common questions</h2>
    <div class="faq" data-panel>
      <h3>How does rerolling work?</h3>
      <p>
        Rerolling means starting a fresh account, playing the opening
        until pulls unlock, and spending the pulls a new account starts
        with. If the results are not what you wanted, you delete or
        abandon that account and start over. It costs time, not money —
        how long one attempt takes depends on how much of the opening
        can be skipped, which changes with game updates.
      </p>
      <h3>Which character should I reroll for?</h3>
      <p>
        We do not name one. Only one of the lists we track publishes a
        reroll pick, and this site never presents a single source as
        settled — the same two-source rule as everything else here.
        What the lists do agree on is in the first section above:
        characters that are strong at Low investment.
      </p>
      <h3>I am stuck in the 魑魅魍魎 quest. Is it bugged?</h3>
      <p>
        Players have reported a problem with this quest: being unable
        to leave the spirit world, with the boss unable to be beaten.
        That is a reported issue, not something we have verified
        ourselves, and we do not have a confirmed workaround. Fixes
        for quest bugs arrive in game updates, so check the official
        in-game notices for word of a fix.
      </p>
      <h3>What should a new account do first?</h3>
      <p>
        Finish the opening story until pulls and the permanent banner
        unlock, then redeem any working codes — the{' '}
        <a href="/codes/">Codes page</a> only lists a code as Active
        when two separate sites say it works. After that, the sections above show what the lists rate
        at Low investment, which is where a new account plays.
      </p>
    </div>
  </section>

  <p class="built">
    Every section on this page comes from the same scores as the tier
    list, picked by the rule in its heading. The full rules are on the <a href="/rules/">Rules page</a>.
  </p>

  <EvidenceDialogs />
</Base>

<style>
  .faq {
    border-radius: var(--radius-xl);
    padding: 6px var(--space-panel) 10px;
  }
  .faq h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    margin: 18px 0 0;
  }
  .faq p {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 5px 0 8px;
  }
  .rise a {
    color: var(--text);
    text-decoration: none;
    font-weight: var(--weight-semibold);
  }
  .rise .arrow {
    color: var(--sub);
    font-size: var(--text-body-sm);
    white-space: nowrap;
  }
</style>
