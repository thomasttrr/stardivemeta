---
// Home tier board (clean guide, 2026-11-24): one list, plain tiers,
// a short reason for every character on their own page. No sources,
// no scoring labels, no investment toggle on the surface.
import Base from '../layouts/Base.astro';
import TierBoard from '../components/TierBoard.astro';
import Stamp from '../components/Stamp.astro';
import Sparkle from '../components/Sparkle.astro';
import { data, stampChecked, titleMonth } from '../lib/data';

const stamp = `Updated ${stampChecked()} · Game version ${data.game_version}`;
---

<Base
  title={`MONGIL: STAR DIVE Tier List (${titleMonth()}) – StarDiveMeta`}
  description="A clean MONGIL: STAR DIVE tier list for players: plain tiers, a short reason for every character, plus codes and banner dates."
  path="/"
>
  <section class="hero">
    <h1 class="display">MONGIL: STAR DIVE <span>tier list</span></h1>
    <span class="star-rule" aria-hidden="true"><Sparkle /></span>
    <p class="tagline">Who's worth building — and why.</p>
    <p class="built">
      One list, plain tiers. Tap a character for the short reason behind
      their tier.
    </p>
  </section>

  <TierBoard />

  <Stamp text={stamp} />

  <ul class="pill-links">
    <li><a class="pill-link" href="/beginner/">New player? Start here</a></li>
    <li><a class="pill-link" href="/codes/">Codes</a></li>
    <li>
      <a class="pill-link" href="/img/generated/tierlist-low.png">Download this list (PNG)</a>
    </li>
  </ul>
</Base>

<style>
  .hero {
    margin-top: 0;
    padding-top: 34px;
    text-align: center;
  }
  .display {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    text-wrap: balance;
    text-shadow: 0 0 26px var(--glow);
    margin: 0;
    animation: rise var(--duration-slow) var(--ease-out) backwards;
  }
  .display span {
    display: block;
    color: var(--lavender);
    font-size: 0.62em;
    margin-top: 6px;
  }
  .hero .star-rule {
    margin-top: 14px;
  }
  .tagline {
    font-size: var(--text-tagline);
    font-weight: var(--weight-medium);
    margin: 12px 0 0;
    animation: rise var(--duration-slow) 60ms var(--ease-out) backwards;
  }
  .hero .built {
    margin-inline: auto;
  }

  /* Short screens (an unfolded iPhone Duo is only ~626px tall): slim
     the opening — smaller title, tighter gaps, no intro line — so the
     S tier row shows without scrolling. Screens of a normal height
     keep the full opening. */
  @media (max-height: 700px) {
    .hero {
      padding-top: 10px;
    }
    .display {
      font-size: 34px;
    }
    .display span {
      margin-top: 2px;
    }
    .hero .star-rule {
      margin-top: 8px;
    }
    .tagline {
      margin-top: 6px;
    }
    .hero .built {
      display: none;
    }
  }
</style>
