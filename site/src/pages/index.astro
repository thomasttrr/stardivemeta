---
// Home tier board (plan T3.2 + §B.5 Home). All three level boards are
// static HTML; <html data-level> + CSS decide which one shows (D-2).
import Base from '../layouts/Base.astro';
import TierBoard from '../components/TierBoard.astro';
import LevelToggle from '../components/LevelToggle.astro';
import Legend from '../components/Legend.astro';
import Stamp from '../components/Stamp.astro';
import Sparkle from '../components/Sparkle.astro';
import EvidenceDialogs from '../components/EvidenceDialogs.astro';
import { LEVELS, data, stampChecked, titleMonth } from '../lib/data';

const stamp = `Lists last checked ${stampChecked()} · v${data.method.version} · Game version ${data.game_version}`;
---

<Base
  title={`MONGIL: STAR DIVE Tier List (${titleMonth()}) – StarDiveMeta`}
  description="Every list disagrees. We show you by how much. The MONGIL: STAR DIVE tier list, combined from Pocket Gamer, Kaiden and GameWith JP."
  path="/"
>
  <section class="hero">
    <h1 class="display">MONGIL: STAR DIVE <span>tier list</span></h1>
    <span class="star-rule" aria-hidden="true"><Sparkle /></span>
    <p class="tagline">Every list disagrees. We show you by how much.</p>
    <p class="built">
      Combined from Pocket Gamer, Kaiden and GameWith JP. Tap a character to
      see what each list says.
    </p>
  </section>
  <LevelToggle />

  {
    LEVELS.map((lv) => (
      <div class={`lvl lvl-${lv}`}>
        <TierBoard board={data.boards[lv]} level={lv} />
      </div>
    ))
  }

  <script is:inline>
    // Moved-since-last-visit markers: remember the tier each character
    // was in per level (localStorage sdm.tiers.<level>); on a later
    // visit, chips whose tier changed get the quiet .moved sparkle.
    // First visit only records — no markers. No surface text is added;
    // the change is named in the chip's aria-label only.
    (function () {
      try {
        ['low', 'high', 'max'].forEach(function (lv) {
          var board = document.querySelector('.lvl-' + lv + ' .tierboard');
          if (!board) return;
          var now = {};
          board.querySelectorAll('.rack').forEach(function (rack) {
            var tier = rack.getAttribute('data-tier');
            rack.querySelectorAll('.chip').forEach(function (chip) {
              now[chip.getAttribute('data-slug')] = tier;
            });
          });
          var key = 'sdm.tiers.' + lv;
          var prev = null;
          try {
            prev = JSON.parse(localStorage.getItem(key) || 'null');
          } catch (e) {}
          if (prev) {
            board.querySelectorAll('.chip').forEach(function (chip) {
              var slug = chip.getAttribute('data-slug');
              if (prev[slug] && prev[slug] !== now[slug]) {
                chip.classList.add('moved');
                chip.setAttribute(
                  'aria-label',
                  chip.getAttribute('aria-label') + '; moved since your last visit',
                );
              }
            });
          }
          try {
            localStorage.setItem(key, JSON.stringify(now));
          } catch (e) {}
        });
      } catch (e) {}
    })();
  </script>

  <Legend />
  <Stamp text={stamp} />

  <ul class="pill-links">
    <li><a class="pill-link" href="/table/">See the full table</a></li>
    <li><a class="pill-link" href="/rules/">How we score</a></li>
    <li><a class="pill-link" href="/notes/">What moved this week</a></li>
    {
      /* One link per investment level; <html data-level> shows the one
         matching the board on screen (Low without JS). */
      LEVELS.map((lv) => (
        <li class={`lvl lvl-${lv}`}>
          <a class="pill-link" href={`/img/generated/tierlist-${lv}.png`}>Download this list (PNG)</a>
        </li>
      ))
    }
  </ul>

  <EvidenceDialogs />
</Base>

<style>
  .hero {
    margin-top: 0;
    padding-top: 34px;
    text-align: center;
  }
  .display {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    text-wrap: balance;
    text-shadow: 0 0 26px var(--glow);
    margin: 0;
    animation: rise var(--duration-slow) var(--ease-out) backwards;
  }
  .display span {
    display: block;
    color: var(--lavender);
    font-size: 0.62em;
    margin-top: 6px;
  }
  .hero .star-rule {
    margin-top: 14px;
  }
  .tagline {
    font-size: var(--text-tagline);
    font-weight: var(--weight-medium);
    margin: 12px 0 0;
    animation: rise var(--duration-slow) 60ms var(--ease-out) backwards;
  }
  .hero .built {
    margin-inline: auto;
  }
</style>
