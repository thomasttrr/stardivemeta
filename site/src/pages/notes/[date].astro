---
// One movers note (plan T4.4). Only approved/auto notes get a page —
// getStaticPaths comes from the same filtered loader as the index,
// and check-dist fails the build if a draft ever renders.
import Base from '../../layouts/Base.astro';
import { loadNotes, renderNoteBody, type Note } from '../../lib/notes';

export function getStaticPaths() {
  return loadNotes().map((note) => ({
    params: { date: note.date },
    props: { note },
  }));
}

interface Props {
  note: Note;
}
const { note } = Astro.props;
const html = renderNoteBody(note.body);
---

<Base title={`${note.title} – StarDiveMeta`} path={`/notes/${note.date}/`} width="prose">
  <article class="note" data-glass set:html={html} />
  <p class="back"><a href="/notes/">All notes</a></p>
</Base>

<style>
  .note {
    margin-top: 28px;
    border-radius: var(--radius-xl);
    padding: 6px var(--space-panel) 24px;
  }
  .note :global(.page-title) {
    margin-top: 20px;
  }
  .note :global(h2) {
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    margin: 22px 0 8px;
  }
  .note :global(p) {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 8px 0 0;
  }
  .note :global(.moves) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .note :global(.moves li) {
    background: var(--chip-fill);
    border: 1px solid var(--chip-rim);
    box-shadow: var(--chip-edge);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    font-size: var(--text-body-sm);
  }
  .note :global(a) {
    color: var(--link);
  }
  .back {
    margin-top: 22px;
    font-size: var(--text-body-sm);
  }
  .back a {
    color: var(--link);
  }
</style>
