---
// Notes index (plan T4.4). Lists the notes that render — approved
// notes and auto zero-change notes (D-12); drafts wait for Tom and
// never appear here. When none render yet, an honest empty state.
import Base from '../../layouts/Base.astro';
import { fmtDate } from '../../lib/data';
import { loadNotes } from '../../lib/notes';

const notes = loadNotes();
---

<Base title="Notes – StarDiveMeta" path="/notes/">
  <h1 class="page-title">What moved</h1>
  <p class="built">
    Each week we publish what changed between snapshots. Every note is
    generated from the snapshot diff, with a link to the list behind
    each move.
  </p>
  {
    notes.length === 0 ? (
      <p class="empty">
        No notes yet. The first note comes after the first full week of
        checks.
      </p>
    ) : (
      <ul class="notes">
        {notes.map((n) => (
          <li>
            <a class="row" href={`/notes/${n.date}/`}>
              <span class="date">{fmtDate(n.date)}</span>
              <span class="title">{n.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .page-title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    margin: 18px 0 4px;
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.01em;
  }
  .built {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 10px 0 0;
  }
  .empty {
    margin: 18px 0 0;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 12px;
    color: var(--sub);
    font-size: var(--text-body-sm);
  }
  .notes {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .notes .row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    text-decoration: none;
  }
  .notes .date {
    color: var(--sub);
    font-size: var(--text-body-sm);
  }
  .notes .title {
    color: var(--text);
    font-weight: var(--weight-semibold);
  }
</style>
