---
// History index (plan T3.8 + T4.3, §B.5 History index). Newest first;
// each entry links to the snapshot's own page (T4.3) with its frozen
// board and the changes from the previous snapshot.
import Base from '../../layouts/Base.astro';
import { snapshotFiles } from '../../adapters/snapshot-v1';
import { fmtDate, history } from '../../lib/data';

const byId = new Map(snapshotFiles.map((f) => [f.id, f]));
const snapshots = [...history.snapshots].sort((a, b) =>
  b.created_at.localeCompare(a.created_at),
);
const earliestId = snapshots.length
  ? snapshots[snapshots.length - 1].id
  : null;

/** The sweep date out of a snapshot id (YYYY-MM-DDT…), falling back
 * to the creation timestamp. */
const snapDate = (id: string, createdAt: string) =>
  fmtDate(/^\d{4}-\d{2}-\d{2}/.test(id) ? id.slice(0, 10) : createdAt.slice(0, 10));

/** Change count for the index line: the raw diff entries against the
 * previous snapshot (null for the baseline, which has no previous). */
const changeCount = (id: string): number | null => {
  const diff = byId.get(id)?.diff;
  if (!diff) return null;
  return (
    diff.tier_changes.length +
    diff.label_changes.length +
    diff.coverage_changes.length +
    diff.placement_changes.length
  );
};
---

<Base title="History – StarDiveMeta" path="/history/" width="prose">
  <h1 class="page-title">History</h1>
  <p class="built">
    Each time the data changes, we save a snapshot. We never edit old
    snapshots.
  </p>

  <ul class="panel-list snaps">
    {
      snapshots.map((s) => {
        const n = changeCount(s.id);
        return (
          <li>
            <a class="row panel-row" data-panel href={`/history/${s.id}/`}>
              <span class="date">{snapDate(s.id, s.created_at)}</span>
              <span class="meta">
                Method v{s.method_version} · Game version {s.game_version}
                {n !== null && ` · ${n} ${n === 1 ? 'change' : 'changes'}`}
                {s.id === earliestId && ' · First snapshot — the baseline'}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .snaps .date {
    color: var(--text);
    font-weight: var(--weight-semibold);
  }
  .snaps .meta {
    color: var(--sub);
    font-size: var(--text-body-sm);
  }
</style>
