---
// Full table page (plan T3.5 + §B.5 Table). Ships zero JS:
// Base's levelScript is off (the table needs no level state).
import Base from '../layouts/Base.astro';
import TierTable from '../components/TierTable.astro';
import Stamp from '../components/Stamp.astro';
import { data, stampChecked } from '../lib/data';

const stamp = `Lists last checked ${stampChecked()} · Method v${data.method.version} · Game version ${data.game_version}`;
---

<Base title="Full Table – StarDiveMeta" path="/table/" levelScript={false}>
  <h1 class="page-title">Full table</h1>
  <p class="built">Same data as the tier list, in one table.</p>

  <TierTable />
  <Stamp text={stamp} />
</Base>

<style>
  .page-title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    margin: 18px 0 4px;
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.01em;
  }
  .built {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 6px 0 0;
  }
</style>
