---
// Full table page (plan T3.5 + §B.5 Table). Base's levelScript is off (the
// table needs no level state); the only JS is the header sort in TierTable.
import Base from '../layouts/Base.astro';
import TierTable from '../components/TierTable.astro';
import Stamp from '../components/Stamp.astro';
import { data, stampChecked } from '../lib/data';

const stamp = `Lists last checked ${stampChecked()} · v${data.method.version} · Game version ${data.game_version}`;
---

<Base description="The full MONGIL: STAR DIVE table: the same data as the tier list, every character in one table." title="Full Table – StarDiveMeta" path="/table/" levelScript={false}>
  <h1 class="page-title">Full table</h1>
  <p class="built">Same data as the tier list, in one table.</p>

  <TierTable />
  <Stamp text={stamp} />
</Base>

