---
// Data page (plan T3.8 + D-8 + §B.5 Data). The two downloads are the
// exact emitted files the site itself is built from, served by the
// endpoints next to this page (data/tierlist.json.ts, data/codes.json.ts).
import Base from '../../layouts/Base.astro';
import { data } from '../../lib/data';
---

<Base title="Data – StarDiveMeta" path="/data/">
  <h1 class="page-title">Data</h1>
  <p class="built">
    Everything on this site comes from these files. They are rebuilt
    with every update.
  </p>
  <ul class="files">
    <li>
      <a href="/data/tierlist.json">tierlist.json</a>
      <span>
        The consensus board: every character, every list's placement,
        the scores and labels.
      </span>
    </li>
    <li>
      <a href="/data/codes.json">codes.json</a>
      <span>
        The codes, with each site's claim and the status we computed
        from them.
      </span>
    </li>
    <li>
      <a href="/data/history.json">history.json</a>
      <span>The snapshot index — one entry per saved snapshot.</span>
    </li>
  </ul>
  <p class="built">Contract version {data.contract_version}.</p>
  <p class="built">
    Source lists belong to their publishers. We link to every one.
  </p>
</Base>

<style>
  .page-title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    margin: 18px 0 4px;
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.01em;
  }
  .built {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 10px 0 0;
  }
  .files {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .files li {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .files a {
    color: var(--teal);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .files span {
    color: var(--sub);
    font-size: var(--text-body-sm);
  }
</style>
