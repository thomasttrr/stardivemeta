---
// Conquest mode page (plan T3.4 + §B.5). Pocket Gamer's calls only —
// labeled as one list's view, not a consensus.
import Base from '../layouts/Base.astro';
import ModeBoard from '../components/ModeBoard.astro';
import Stamp from '../components/Stamp.astro';
import EvidenceDialogs from '../components/EvidenceDialogs.astro';
import { data, fmtDate, sourcesById } from '../lib/data';

const pg = sourcesById.get('pg');
---

<Base title="Conquest Tier List – StarDiveMeta" path="/conquest/">
  <h1 class="page-title">Conquest tier list</h1>
  <p class="single-source">
    Only Pocket Gamer ranks characters by mode. These are its calls, not a
    consensus.
  </p>
  <p class="built">Conquest = boss fights, single target.</p>

  <ModeBoard board={data.mode_boards.conquest} />

  <Stamp text={`Pocket Gamer list dated ${fmtDate(pg?.list_date ?? null)}`} />
  <EvidenceDialogs />
</Base>

<style>
  .single-source {
    font-size: var(--text-tagline);
    margin: 0;
    color: var(--gold);
    font-weight: var(--weight-semibold);
  }
</style>
