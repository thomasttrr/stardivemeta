---
// Dimensional Rift mode page (plan T3.4 + §B.5). Pocket Gamer's calls
// only — labeled as one list's view, not a consensus.
import Base from '../layouts/Base.astro';
import ModeBoard from '../components/ModeBoard.astro';
import Stamp from '../components/Stamp.astro';
import EvidenceDialogs from '../components/EvidenceDialogs.astro';
import { data, fmtDate, sourcesById } from '../lib/data';

const pg = sourcesById.get('pg');
---

<Base title="Dimensional Rift Tier List – StarDiveMeta" path="/rift/">
  <h1 class="page-title">Dimensional Rift tier list</h1>
  <p class="single-source">
    Only Pocket Gamer ranks characters by mode, so these are its calls
    alone.
  </p>
  <p class="built">Rift = dungeons, many enemies.</p>

  <ModeBoard board={data.mode_boards.rift} />

  <Stamp text={`Pocket Gamer list dated ${fmtDate(pg?.list_date ?? null)}`} />
  <EvidenceDialogs />
</Base>

<style>
  .single-source {
    font-size: var(--text-tagline);
    margin: 0;
    color: var(--starlight);
    font-weight: var(--weight-semibold);
  }
</style>
