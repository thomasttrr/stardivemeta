---
// Direction B — "The Tier Review" (see HTML comment below for rationale).
import { lowRows, francis, LEGEND, stamp } from '../../lib/mock-data';
---

<!--
  Direction B: "The Tier Review" — an editorial / magazine direction.
  Rationale: reads like a weekly journal column — oversized serif headlines, numbered
  sections and a pull-quote verdict — which suits the movers-note, essay side of the site.
  Layout: a single centred reading column; tiers are chapters with huge letters, not rows in a grid.
-->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mock B — The Tier Review · StarDiveMeta</title>
    <style>
      :root {
        --paper: #fdfcf9;
        --ink: #141310;
        --sub: #55534b;
        --hair: #ddd9cd;
        --accent: #8c2f0e;
        --serif: Georgia, "Iowan Old Style", "Times New Roman", serif;
        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 16px; line-height: 1.55; }
      main { max-width: 600px; margin: 0 auto; padding: 28px 20px 48px; }
      .masthead { text-align: center; border-bottom: 1px solid var(--ink); padding-bottom: 14px; }
      .masthead .site { font-family: var(--serif); font-size: 15px; letter-spacing: 0.28em; text-transform: uppercase; }
      .masthead .mock { font-size: 12px; color: var(--sub); letter-spacing: 0.12em; text-transform: uppercase; margin-top: 4px; }
      h1 { font-family: var(--serif); font-weight: 600; font-size: 40px; line-height: 1.08; text-align: center; margin: 26px 0 10px; letter-spacing: -0.01em; }
      .standfirst { font-family: var(--serif); font-style: italic; font-size: 19px; text-align: center; color: var(--ink); margin: 0 24px; }
      .byline { text-align: center; color: var(--sub); font-size: 13.5px; margin: 14px 0 0; }
      .toggle { display: flex; justify-content: center; gap: 22px; margin: 26px 0 6px; font-family: var(--serif); font-size: 17px; }
      .toggle .opt { color: var(--sub); }
      .toggle .opt.on { color: var(--ink); font-weight: 700; border-bottom: 2px solid var(--accent); padding-bottom: 2px; }
      .tnote { text-align: center; color: var(--sub); font-size: 13.5px; margin: 4px 30px 0; }
      section.tier { margin-top: 38px; }
      .tierhead { display: flex; align-items: baseline; gap: 14px; border-bottom: 1px solid var(--hair); padding-bottom: 6px; }
      .tierhead .big { font-family: var(--serif); font-size: 54px; line-height: 0.9; font-weight: 600; }
      .tierhead .meta { color: var(--sub); font-size: 13px; }
      .tierhead .meta .band { display: block; font-size: 13.5px; color: var(--ink); }
      ul.names { list-style: none; margin: 10px 0 0; padding: 0; }
      ul.names li { display: flex; align-items: baseline; gap: 10px; padding: 7px 0; border-bottom: 1px dotted var(--hair); }
      ul.names li:last-child { border-bottom: none; }
      ul.names .nm { font-family: var(--serif); font-size: 20px; }
      ul.names .tag { margin-left: auto; font-size: 12.5px; color: var(--sub); white-space: nowrap; }
      ul.names .tag b { color: var(--ink); font-weight: 600; }
      ul.names li[data-label="CONTESTED"] .tag b { color: var(--accent); }
      ul.names li[data-label="SPECULATION"] .nm { border-bottom: 1px dashed var(--sub); }
      .legend { margin: 40px 0 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); padding: 12px 0; font-size: 14px; }
      .legend p { margin: 4px 0; }
      h2 { font-family: var(--serif); font-size: 30px; font-weight: 600; margin: 44px 0 4px; line-height: 1.15; }
      .evkicker { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
      .evsum { font-family: var(--serif); font-size: 17px; margin: 8px 0 0; }
      .evsum .cur { font-weight: 700; }
      .evsum .sep { color: var(--sub); margin: 0 8px; }
      .numbers { color: var(--sub); font-size: 14px; margin: 6px 0 0; }
      blockquote.why {
        font-family: var(--serif); font-size: 20px; line-height: 1.4; font-style: italic;
        margin: 22px 6px; padding: 0 0 0 18px; border-left: 3px solid var(--accent);
      }
      .evlist { margin-top: 18px; }
      .evrow { padding: 12px 0; border-top: 1px solid var(--hair); }
      .evrow:last-child { border-bottom: 1px solid var(--hair); }
      .evrow .src { font-family: var(--serif); font-size: 18px; font-weight: 600; }
      .evrow .plc { display: block; margin-top: 2px; font-size: 15px; }
      .evrow .meta { display: block; color: var(--sub); font-size: 13px; margin-top: 2px; }
      h3 { font-family: var(--serif); font-size: 19px; margin: 26px 0 6px; }
      .crit { font-size: 14.5px; margin: 5px 0; color: var(--ink); }
      .crit b { font-family: var(--serif); }
      .stamp { margin-top: 40px; text-align: center; color: var(--sub); font-size: 12.5px; border-top: 1px solid var(--hair); padding-top: 12px; }
    </style>
  </head>
  <body>
    <main>
      <div class="masthead">
        <div class="site">StarDiveMeta</div>
        <div class="mock">Design mock B — The Tier Review</div>
      </div>

      <h1>MONGIL: STAR DIVE tier list</h1>
      <p class="standfirst">Every list disagrees. We show you by how much.</p>
      <p class="byline">Built from 3 tier lists: Pocket Gamer, Kaiden and GameWith JP. Tap a character to see what each list says.</p>

      <div class="toggle" role="group" aria-label="Investment level">
        <span class="opt on">Low</span><span class="opt">High</span><span class="opt">Max</span>
      </div>
      <p class="tnote">Only Kaiden rates by investment. The other two lists stay the same at every level. Watch who climbs as investment rises.</p>

      {lowRows.map((row, i) => (
        <section class="tier" aria-label={`Tier ${row.tierLabel}`}>
          <div class="tierhead">
            <span class="big">{row.tierLabel}</span>
            <span class="meta">
              <span class="band">Scores {row.band}</span>
              Section {i + 1} · {row.chips.length} characters
            </span>
          </div>
          <ul class="names">
            {row.chips.map((chip) => (
              <li data-label={chip.label}>
                <span class="nm">{chip.name}</span>
                <span class="tag"><span aria-hidden="true">{chip.glyph}</span> <b>{chip.labelWord}</b>{chip.score && <> · {chip.score}</>}{chip.label === 'SPECULATION' && <> · 1 list</>}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <div class="legend">
        {LEGEND.map((l) => (
          <p><span aria-hidden="true">{l.glyph}</span> <b>{l.word}</b> — {l.text}</p>
        ))}
      </div>

      <h2><span class="evkicker">Evidence</span><br />{francis.name}, up close</h2>
      <p class="evsum">
        {francis.summary.map((s, i) => (
          <>{i > 0 && <span class="sep">·</span>}<span class={s.current ? 'cur' : undefined}>{s.word}: {s.tier} · {s.labelWord}</span></>
        ))}
      </p>
      <p class="numbers">{francis.numbers}</p>
      <blockquote class="why">Why Contested — {francis.why}</blockquote>

      <div class="evlist">
        {francis.counted.map((line) => (
          <div class="evrow">
            <span class="src">{line.sourceName}</span>
            <span class="plc">{line.placementText}</span>
            <span class="meta">Our number: {line.convertedText} · {line.dateText}{line.note && <> · {line.note}</>}</span>
          </div>
        ))}
      </div>

      <h3>Criteria notes</h3>
      {francis.criteria.map((c) => (
        <p class="crit"><b>{c.name}.</b> {c.text}</p>
      ))}

      <h3>Not counted, shown for context</h3>
      <div class="evlist">
        {francis.notCounted.map((line) => (
          <div class="evrow">
            <span class="src">{line.sourceName}</span>
            <span class="plc">{line.placementText}</span>
            <span class="meta">{line.reason} · {line.dateText}</span>
          </div>
        ))}
      </div>

      <p class="crit" style="margin-top:20px"><b>Modes.</b> {francis.modes}</p>
      <p class="stamp">{stamp}</p>
    </main>
  </body>
</html>
