---
// Direction A — "Ledger Sheet" (see HTML comment below for rationale).
import { lowRows, francis, LEGEND, stamp } from '../../lib/mock-data';
---

<!--
  Direction A: "Ledger Sheet" — the data-sheet direction.
  Rationale: the site's whole claim is "we show the numbers", so this treats the
  board like a printed results table — dense ruled rows, mono numerals, no decoration.
  Layout: one full-width ledger; tier = row stub with band + count; evidence = a ruled table.
-->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mock A — Ledger Sheet · StarDiveMeta</title>
    <style>
      :root {
        --paper: #fbfaf7;
        --ink: #191919;
        --sub: #4c4c48;
        --rule: #191919;
        --hair: #c9c7bf;
        --accent: #7c2d12;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--paper); color: var(--ink);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        font-size: 15px; line-height: 1.45;
      }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
      main { max-width: 640px; margin: 0 auto; padding: 16px 14px 40px; }
      .kicker {
        display: flex; justify-content: space-between; gap: 8px;
        border-bottom: 2px solid var(--rule); padding-bottom: 6px;
        font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sub);
      }
      .kicker b { color: var(--ink); }
      h1 { font-size: 26px; line-height: 1.15; margin: 14px 0 4px; letter-spacing: -0.01em; }
      .sub { font-size: 16px; margin: 0 0 4px; }
      .built { color: var(--sub); font-size: 13px; margin: 0 0 14px; }
      .toggle { display: flex; align-items: center; gap: 0; border: 1px solid var(--rule); width: fit-content; }
      .toggle span, .toggle b { padding: 5px 12px; font-size: 13px; }
      .toggle b { background: var(--ink); color: var(--paper); }
      .toggle span + span, .toggle span + b, .toggle b + span { border-left: 1px solid var(--rule); }
      .tnote { font-size: 12.5px; color: var(--sub); margin: 8px 0 0; }
      table { width: 100%; border-collapse: collapse; margin-top: 16px; }
      th, td { border-top: 1px solid var(--rule); padding: 8px 6px; vertical-align: top; text-align: left; }
      tr:last-child td, tr:last-child th { border-bottom: 1px solid var(--rule); }
      .tiercell { width: 74px; }
      .tiercell .t { font-size: 22px; font-weight: 700; line-height: 1; }
      .tiercell .band { display: block; font-size: 11.5px; color: var(--sub); margin-top: 3px; }
      .tiercell .n { display: block; font-size: 11.5px; color: var(--sub); }
      .chips { display: flex; flex-wrap: wrap; gap: 5px 14px; }
      .chip { display: inline-flex; align-items: baseline; gap: 5px; white-space: nowrap; }
      .chip .nm { font-weight: 600; }
      .chip .gl { font-size: 12px; }
      .chip .lb { font-size: 11.5px; color: var(--sub); }
      .chip .sc { font-size: 12.5px; color: var(--sub); }
      .chip[data-label="CONTESTED"] .gl { color: var(--accent); }
      .chip[data-label="SPECULATION"] { outline: 1px dashed var(--sub); outline-offset: 2px; }
      .legend { margin-top: 14px; font-size: 13px; }
      .legend div { padding: 3px 0; border-top: 1px solid var(--hair); }
      .legend div:last-child { border-bottom: 1px solid var(--hair); }
      h2 { font-size: 18px; margin: 30px 0 2px; border-bottom: 2px solid var(--rule); padding-bottom: 5px; }
      .evsum { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 13.5px; margin: 8px 0 0; }
      .evsum .cur { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
      .numbers { font-size: 13.5px; margin: 6px 0 0; }
      .why { margin: 10px 0 0; font-size: 14.5px; }
      .why b { color: var(--accent); }
      .evtable td:first-child { font-weight: 600; width: 27%; }
      .evtable .num { text-align: right; width: 52px; }
      .note { font-size: 12.5px; color: var(--sub); }
      h3 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.07em; margin: 18px 0 4px; }
      .crit { font-size: 13px; margin: 3px 0; }
      .crit b { font-weight: 600; }
      .stamp { margin-top: 26px; border-top: 2px solid var(--rule); padding-top: 8px; font-size: 12.5px; color: var(--sub); }
    </style>
  </head>
  <body>
    <main>
      <div class="kicker"><b>StarDiveMeta</b><span>Design mock A — Ledger Sheet</span></div>
      <h1>MONGIL: STAR DIVE tier list</h1>
      <p class="sub">Every list disagrees. We show you by how much.</p>
      <p class="built">Built from 3 tier lists: Pocket Gamer, Kaiden and GameWith JP. Tap a character to see what each list says.</p>

      <div class="toggle" role="group" aria-label="Investment level"><span>Investment:</span><b>Low</b><span>High</span><span>Max</span></div>
      <p class="tnote">Only Kaiden rates by investment. The other two lists stay the same at every level.</p>
      <p class="tnote">Watch who climbs as investment rises.</p>

      <table aria-label="Tier list at Low investment">
        <tbody>
          {lowRows.map((row) => (
            <tr>
              <th class="tiercell" scope="row">
                <span class="t">{row.tierLabel}</span>
                <span class="band mono">{row.band}</span>
                <span class="n mono">{row.chips.length} chars</span>
              </th>
              <td>
                <div class="chips">
                  {row.chips.map((chip) => (
                    <span class="chip" data-label={chip.label}>
                      <span class="nm">{chip.name}</span>
                      <span class="gl" aria-hidden="true">{chip.glyph}</span>
                      <span class="lb">{chip.labelWord}{chip.label === 'SPECULATION' ? ' · 1 list' : ''}</span>
                      {chip.score && <span class="sc mono">{chip.score}</span>}
                    </span>
                  ))}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="legend">
        {LEGEND.map((l) => (
          <div><span aria-hidden="true">{l.glyph}</span> <b>{l.word}</b> — {l.text}</div>
        ))}
      </div>

      <h2>Evidence — {francis.name}</h2>
      <p class="evsum">
        {francis.summary.map((s) => (
          <span class={s.current ? 'cur' : undefined}>{s.word}: {s.tier} · {s.labelWord}</span>
        ))}
      </p>
      <p class="numbers mono">{francis.numbers}</p>
      <p class="why"><b>Why Contested:</b> {francis.why}</p>

      <table class="evtable" aria-label="What each list says about Francis">
        <tbody>
          {francis.counted.map((line) => (
            <tr>
              <td>{line.sourceName}</td>
              <td>{line.placementText}{line.note && <div class="note">{line.note}</div>}</td>
              <td class="num mono">{line.convertedText}</td>
              <td class="mono">{line.dateText}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h3>Criteria notes</h3>
      {francis.criteria.map((c) => (
        <p class="crit"><b>{c.name}:</b> {c.text}</p>
      ))}

      <h3>Not counted (shown for context)</h3>
      <table class="evtable" aria-label="Sources not counted for Francis">
        <tbody>
          {francis.notCounted.map((line) => (
            <tr>
              <td>{line.sourceName}</td>
              <td>{line.placementText}<div class="note">{line.reason}</div></td>
              <td class="num mono">—</td>
              <td class="mono">{line.dateText}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="crit" style="margin-top:14px"><b>Modes:</b> {francis.modes}</p>
      <p class="stamp mono">{stamp}</p>
    </main>
  </body>
</html>
