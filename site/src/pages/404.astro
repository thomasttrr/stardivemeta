---
// 404 page (plan T3.1). Uses the shell, so it carries the disclaimer.
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found – StarDiveMeta" path="/404.html">
  <h1 class="page-title">Page not found</h1>
  <p class="built">
    That page isn't here. <a href="/">Back to the tier list</a>.
  </p>
</Base>

<style>
  .page-title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    margin: 18px 0 4px;
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.01em;
  }
  .built {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 6px 0 0;
  }
</style>
