---
// About page (plan T3.8 + §B.5 About). Part E Q4 answered "none"
// (D-9 vetoed), so there is deliberately no corrections email line.
// The disclaimer is repeated in full in the body, per §B.5 item 6
// (it also runs in the footer of every page).
import Base from '../layouts/Base.astro';
import Disclaimer from '../components/Disclaimer.astro';
---

<Base title="About – StarDiveMeta" path="/about/">
  <h1 class="page-title">About</h1>
  <p class="built">StarDiveMeta is a fan project by one player.</p>
  <p class="built">
    It combines public tier lists and shows where they agree and where
    they don't.
  </p>
  <p class="built">No ads. No accounts.</p>
  <div class="disclaimer-block">
    <Disclaimer />
  </div>
</Base>

<style>
  .page-title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    margin: 18px 0 4px;
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.01em;
  }
  .built {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 10px 0 0;
  }
  .disclaimer-block {
    margin-top: 22px;
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
</style>
