---
// Site shell (plan T3.1): head meta + canonical + OG tags, the inline
// level-restore script, the Starfield header (sparkle + serif wordmark
// over a row of nav pills), footer with the disclaimer, and the fixed
// night sky behind everything.
// No social share buttons or embeds anywhere (Tom's standing rule);
// OG meta only, per plan D-7.
import '../styles/global.css';
import Disclaimer from '../components/Disclaimer.astro';
import Sparkle from '../components/Sparkle.astro';

interface Props {
  title: string;
  description?: string;
  /** Canonical path, e.g. "/" or "/c/francis/". */
  path: string;
  /** Board scripts: the level restore + evidence dialogs. Set false
   * for pages with neither (plan T3.5 table). */
  levelScript?: boolean;
  /** Column width: "wide" for boards and tables, "prose" for reading. */
  width?: 'wide' | 'prose';
  /** Keep the page out of search (the 404 page): robots noindex, and
   * no canonical / og:url claiming the URL as a real page. */
  noindex?: boolean;
}

const {
  title,
  description = 'Every list disagrees. We show you by how much.',
  path,
  levelScript = true,
  width = 'wide',
  noindex = false,
} = Astro.props;

const canonical = `https://stardivemeta.com${path}`;
const ogImage = 'https://stardivemeta.com/img/generated/og.png';
// The sparkle (Sparkle.astro) on the night ground, inline so G14 sees no new image file.
const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect width="24" height="24" rx="5" fill="#150f38"/><path transform="translate(3 3) scale(.75)" fill="#ffd98a" d="M12 0C12.7 7.6 16.4 11.3 24 12 16.4 12.7 12.7 16.4 12 24 11.3 16.4 7.6 12.7 0 12 7.6 11.3 11.3 7.6 12 0Z"/></svg>',
  );

const nav = [
  { href: '/', label: 'Tier list' },
  { href: '/conquest/', label: 'Conquest' },
  { href: '/rift/', label: 'Rift' },
  { href: '/table/', label: 'Table' },
  { href: '/beginner/', label: 'Beginner' },
  { href: '/codes/', label: 'Codes' },
  { href: '/banner/', label: 'New characters' },
  { href: '/rules/', label: 'Rules' },
];
const footerNav = [
  { href: '/history/', label: 'History' },
  { href: '/notes/', label: 'Notes' },
  { href: '/corrections/', label: 'Corrections' },
  { href: '/data/', label: 'Data' },
  { href: '/about/', label: 'About' },
];
const current = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="en" data-level="low">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0a26" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      levelScript && (
        <script is:inline>
          document.documentElement.classList.add('js');
          try {
            var q = new URLSearchParams(location.search).get('level');
            var l = q || localStorage.getItem('sdm.level');
            if (l === 'low' || l === 'high' || l === 'max') {
              document.documentElement.dataset.level = l;
              if (q) {
                try { localStorage.setItem('sdm.level', l); } catch (e) {}
              }
            }
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scene" aria-hidden="true">
      <svg class="orbit" viewBox="0 0 1000 1000" preserveAspectRatio="none">
        <ellipse cx="1080" cy="150" rx="900" ry="560" />
        <ellipse cx="-120" cy="900" rx="760" ry="300" />
      </svg>
    </div>

    <div class={`shell shell-${width}`}>
      <header class="site-header">
        <a class="brand" href="/">
          <Sparkle />
          <span>StarDiveMeta</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
      </header>
      <script is:inline>
        // Phones: centre the current page in the sideways-scrolling nav.
        (function () {
          var n = document.querySelector('.site-nav');
          var a = n && n.querySelector('[aria-current]');
          if (a && n.scrollWidth > n.clientWidth) n.scrollLeft = a.offsetLeft - (n.clientWidth - a.offsetWidth) / 2;
        })();
      </script>

      <main id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <span class="star-rule" aria-hidden="true"><Sparkle /></span>
        <nav class="footer-nav" aria-label="Footer">
          {
            footerNav.map((n) => (
              <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
        <Disclaimer />
      </footer>
    </div>

    {
      levelScript && (
        <script>
          import '../scripts/dialog.ts';
        </script>
      )
    }
  </body>
</html>

<style>
  .shell {
    position: relative;
    z-index: 1;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-page-top) max(var(--space-page-x), env(safe-area-inset-right, 0px)) 0
      max(var(--space-page-x), env(safe-area-inset-left, 0px));
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 1100px) {
    .shell-wide {
      max-width: var(--content-max-wide);
    }
  }
  .shell-prose main {
    width: 100%;
    max-width: var(--prose-max);
    margin-inline: auto;
  }
  main {
    flex: 1;
  }

  /* header: the official site's centred wordmark */
  .site-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: 14px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-brand);
    line-height: 1;
    letter-spacing: 0.01em;
    text-shadow: 0 0 22px var(--glow);
  }
  .brand :global(.spk) {
    width: 22px;
    height: 22px;
    margin-bottom: 2px;
    transition: transform var(--duration-slow) var(--ease-spring);
  }
  .brand:hover :global(.spk) {
    transform: rotate(90deg) scale(1.1);
  }
  .site-nav {
    display: flex;
    gap: 4px;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--chip-fill);
    border: 1px solid var(--chip-rim);
  }
  .site-nav a {
    white-space: nowrap;
    text-decoration: none;
    color: var(--sub);
    font-weight: var(--weight-semibold);
    font-size: var(--text-body-sm);
    padding: 0 14px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    transition:
      background-color var(--duration-fast),
      color var(--duration-fast);
  }
  .site-nav a:hover {
    color: var(--text);
    background: var(--chip-fill-hover);
  }
  .site-nav a[aria-current="page"] {
    color: var(--on-lavender);
    background: var(--lavender);
    font-weight: var(--weight-bold);
  }

  /* footer */
  .site-footer {
    margin-top: 56px;
    padding: 0 0 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
  }
  .site-footer .star-rule {
    width: 100%;
    max-width: 420px;
    margin-bottom: 6px;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 20px;
  }
  .footer-nav a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--sub);
    font-size: var(--text-body-sm);
    text-decoration: none;
  }
  .footer-nav a:hover,
  .footer-nav a[aria-current="page"] {
    color: var(--text);
  }

  @media (max-width: 620px) {
    .shell {
      padding-top: 6px;
    }
    .site-nav {
      align-self: stretch;
      border-radius: 22px;
    }
  }
</style>
