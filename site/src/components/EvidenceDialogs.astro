---
// All 29 evidence dialogs for a board page (plan T3.3). Pre-rendered,
// one <dialog> per character; dialog.ts wires chip clicks to them.
// Without JS the chips simply link to /c/<slug>/.
import { data } from '../lib/data';
import EvidencePanel from './EvidencePanel.astro';
---

{
  data.characters.map((c) => (
    <dialog class="ev-dialog" id={`ev-${c.id}`} aria-label={`${c.name} evidence`}>
      <button class="ev-close" type="button" data-close aria-label="Close evidence">
        ✕
      </button>
      <EvidencePanel character={c} />
    </dialog>
  ))
}

<style>
  .ev-dialog {
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    padding: 0;
    width: calc(100% - 28px);
    max-width: var(--content-max);
    max-height: calc(100vh - 40px);
    overflow: auto;
  }
  .ev-dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .ev-dialog :global(.dossier) {
    border: none;
    border-radius: 0;
  }
  .ev-close {
    position: sticky;
    top: 10px;
    float: right;
    margin: 10px 10px 0 0;
    background: var(--panel-2);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    width: 34px;
    height: 34px;
    font-size: 14px;
    cursor: pointer;
    z-index: 1;
  }
</style>
