---
// One character chip (clean guide, 2026-11-24): the medallion portrait
// and the name — nothing else on the board surface. The tier comes
// from the rack the chip sits in; the short reason is one tap away on
// the character page. Styles: global.css "Character chip".
import type { Character } from '../types/contract/Character';
import Medallion from './Medallion.astro';

interface Props {
  character: Character;
  /** The rack this chip sits in, for the accessible name. */
  tier: string;
  /** Eager-load the portrait (the board's first rack is above the fold). */
  eager?: boolean;
}
const { character: c, tier, eager = false } = Astro.props;
---

<a
  class="chip"
  href={`/c/${c.id}/`}
  data-slug={c.id}
  aria-label={`${c.name}: tier ${tier}`}
>
  <Medallion id={c.id} name={c.name} eager={eager} />
  <span class="chip-name">{c.name}</span>
</a>
