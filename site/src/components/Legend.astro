---
// Label legend (plan §B.5 Home item 6). Mark + word + plain meaning —
// never colour alone.
import LabelMark from './LabelMark.astro';
import type { Label } from '../types/contract/Label';

const items: { label: Label; word: string; text: string }[] = [
  { label: 'SOLID', word: 'Solid', text: 'the lists agree within 1 tier.' },
  { label: 'CONTESTED', word: 'Contested', text: 'the lists are more than 1 tier apart.' },
  { label: 'SPECULATION', word: 'Speculation', text: 'only 1 list has placed them so far.' },
  {
    label: 'MODE_SPLIT',
    word: 'Mode-split',
    text: 'strong in one mode, weak in the other. See Conquest and Rift.',
  },
];
---

<div class="legend" data-glass>
  {
    items.map((i) => (
      <p>
        <LabelMark label={i.label} />
        <span>
          <b>{i.word}</b> — {i.text}
        </span>
      </p>
    ))
  }
</div>

<style>
  .legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 28px;
    margin-top: var(--space-section);
    border-radius: var(--radius-lg);
    padding: 18px var(--space-panel);
    font-size: var(--text-note);
    color: var(--sub);
  }
  .legend p {
    margin: 0;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .legend :global(.mark) {
    flex: none;
    margin-top: 2px;
    color: var(--text);
  }
  .legend b {
    color: var(--text);
    font-weight: var(--weight-semibold);
  }
  @media (max-width: 620px) {
    .legend {
      grid-template-columns: 1fr;
      padding: 16px 18px;
    }
  }
</style>
