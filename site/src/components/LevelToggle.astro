---
// Investment toggle (plan T3.2 + D-4): the floating LevelDock island
// (React + Motion, client-only — it is pure behaviour, so it renders no
// static markup) plus the one-line note. Without JS, Low shows and the
// noscript line links to the table page's level anchors.
// CP3 debloat (Tom, 2026-10-29): the note under the toggle is ONE line;
// Kaiden's level definitions live in full on the Rules page.
import LevelDock from '../islands/LevelDock';
---

<LevelDock client:only="react" />
<noscript>
  <p class="tnote">
    Investment: <a href="/table/#low">Low</a> · <a href="/table/#high">High</a> ·{' '}
    <a href="/table/#max">Max</a> (on the table page)
  </p>
</noscript>
<p class="tnote">
  Only Kaiden rates by investment — the other lists stay fixed. Kaiden's
  levels are defined on the <a href="/rules/">Rules page</a>.
</p>

<style>
  .tnote {
    color: var(--sub);
    font-size: var(--text-note);
    margin: 10px 0 0;
    animation: rise var(--duration-slow) 160ms var(--ease-out) backwards;
  }
</style>

<style is:global>
  .dock {
    position: fixed;
    left: 50%;
    bottom: max(18px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 20;
    border-radius: var(--radius-pill);
    padding: 6px;
    animation: dock-in 800ms 250ms var(--ease-spring) backwards;
  }
  .dock.lensed {
    background-color: var(--dock-fill);
    -webkit-backdrop-filter: url(#sdm-dock-lens) saturate(180%);
    backdrop-filter: url(#sdm-dock-lens) saturate(180%);
  }
  .dock-filter {
    position: absolute;
  }
  .dock .segs {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 0 0 0 14px;
    border: 0;
    min-width: 0;
  }
  .dock .dlbl {
    font-size: var(--text-kicker);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--sub);
  }
  .dock .track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 300px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--tint-dark);
  }
  .dock .seg {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 44px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    color: var(--sub);
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
  }
  .dock .seg input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }
  .dock .seg-text {
    position: relative;
    z-index: 1;
    transition: color var(--duration-fast);
  }
  .dock .seg:hover .seg-text {
    color: var(--text);
  }
  .dock .seg.on .seg-text {
    color: #fff;
    font-weight: var(--weight-bold);
  }
  .dock .seg input:focus-visible ~ .seg-text {
    outline: 2px solid var(--gold);
    outline-offset: 6px;
    border-radius: 6px;
  }
  .dock .slider {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
  }
  .dock .slider-glass {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    background: var(--gold-glass);
    border: 1px solid var(--gold-rim);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      inset 0 -6px 12px rgb(255 207 90 / 0.12),
      0 4px 14px rgb(0 0 0 / 0.28);
  }
  @keyframes dock-in {
    from {
      opacity: 0;
      translate: 0 30px;
      scale: 0.92;
    }
  }
  @media (max-width: 620px) {
    .dock {
      left: 12px;
      right: 12px;
      bottom: max(12px, env(safe-area-inset-bottom));
      transform: none;
    }
    .dock .segs {
      padding-left: 10px;
      gap: 10px;
    }
    .dock .track {
      width: auto;
      flex: 1;
    }
  }
</style>
