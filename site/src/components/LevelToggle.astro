---
// Investment toggle (plan T3.2 + D-4): the game's violet pill tabs, in a
// night band that sticks to the top of the screen while the board
// scrolls. Native radios keep keyboard and screen-reader behaviour; the
// inline script only flips <html data-level> and remembers the choice
// (localStorage sdm.level). The tabs show only with JS (html.js, set by
// Base's head script); without it, Low shows and the noscript line
// links to the table page's level anchors.
// CP3 debloat (Tom, 2026-10-29): the note under the toggle is ONE line;
// Kaiden's level definitions live in full on the Rules page.
import { LEVELS, LEVEL_NAME } from '../lib/data';
---

<div class="lvbar">
  <fieldset class="lvtabs">
    <legend class="sr-only">Investment level</legend>
    {
      LEVELS.map((lv) => (
        <label class="lvtab">
          <input type="radio" name="sdm-level" value={lv} checked={lv === 'low'} />
          <span>{LEVEL_NAME[lv]}</span>
        </label>
      ))
    }
  </fieldset>
</div>
<script is:inline>
  (function () {
    var root = document.documentElement;
    var radios = document.querySelectorAll('input[name="sdm-level"]');
    radios.forEach(function (r) {
      r.checked = r.value === root.dataset.level;
      r.addEventListener('change', function () {
        root.dataset.level = r.value;
        try { localStorage.setItem('sdm.level', r.value); } catch (e) {}
      });
    });
  })();
</script>
<noscript>
  <p class="tnote">
    Investment: <a href="/table/#low">Low</a> · <a href="/table/#high">High</a> ·{' '}
    <a href="/table/#max">Max</a> (on the table page)
  </p>
</noscript>
<p class="tnote">
  Only Kaiden rates by investment — the other lists stay fixed. Kaiden's
  levels are defined on the <a href="/rules/">Rules page</a>.
</p>

<style>
  .tnote {
    color: var(--sub);
    font-size: var(--text-note);
    text-align: center;
    /* clears the soft fade under the level bar */
    margin: 26px 0 0;
    animation: rise var(--duration-slow) 160ms var(--ease-out) backwards;
  }
  /* The band spans the full viewport width (shadow + clip trick, so the
     page never gains a horizontal scroll). */
  .lvbar {
    display: none;
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    margin-top: 22px;
    padding: 12px 0 14px;
    background: var(--band);
    box-shadow:
      0 0 0 100vmax var(--band),
      0 1px 0 100vmax var(--hairline),
      0 16px 18px 100vmax var(--band);
    clip-path: inset(0 -100vmax -26px);
  }
  :global(html.js) .lvbar {
    display: block;
  }
  .lvtabs {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .lvtab {
    position: relative;
    flex: 0 1 130px;
    display: grid;
    place-items: center;
    min-height: 44px;
    border-radius: var(--radius-pill);
    background: var(--pill);
    box-shadow: inset 0 0 0 1px var(--pill-rim);
    color: var(--text);
    font-weight: var(--weight-bold);
    font-size: var(--text-base);
    cursor: pointer;
    transition:
      background-color var(--duration-fast),
      transform var(--duration-base) var(--ease-spring);
  }
  .lvtab:hover {
    transform: translateY(-1px);
  }
  .lvtab input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .lvtab:has(input:checked) {
    background: var(--lavender);
    color: var(--on-lavender);
  }
  /* the selected tab points down at the board, as on the official site */
  .lvtab:has(input:checked)::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -6px;
    margin-left: -6px;
    border: 6px solid transparent;
    border-bottom: 0;
    border-top-color: var(--lavender);
  }
  .lvtab:has(input:focus-visible) {
    outline: 2px solid var(--starlight);
    outline-offset: 3px;
  }
</style>
