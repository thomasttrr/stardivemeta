---
// The rack head: a tinted glass lens with the tier letter (or the
// mode-split / unranked mark) and the character count beneath it.
interface Props {
  tier: string;
  count: number;
}
const { tier, count } = Astro.props;
---

<div class="rack-head">
  <div class="lens" aria-hidden="true">
    {
      tier === 'MODE_SPLIT' ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8h17M16 4l4 4-4 4M21 16H4M8 12l-4 4 4 4" />
        </svg>
      ) : tier === 'UNRANKED' ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <path d="M6 12h12" />
        </svg>
      ) : (
        tier
      )
    }
  </div>
  <span class="rack-count">
    {count}<span class="sr-only"> {count === 1 ? 'character' : 'characters'}</span>
  </span>
</div>
