---
// The tier heading, as on the official character page: the serif tier
// letter (S crowned with an arc of five sparkles; mode-split and
// unranked spelled out), a sparkle rule, and the character count.
import Sparkle from './Sparkle.astro';

interface Props {
  tier: string;
  count: number;
}
const { tier, count } = Astro.props;
const ARC: [number, number, number][] = [
  [14, 19, 5],
  [34, 9, 6],
  [60, 4, 8],
  [86, 9, 6],
  [106, 19, 5],
];
const SPARK = 'M12 0C12.7 7.6 16.4 11.3 24 12 16.4 12.7 12.7 16.4 12 24 11.3 16.4 7.6 12.7 0 12 7.6 11.3 11.3 7.6 12 0Z';
---

<div class="rack-head">
  {
    tier === 'S' && (
      <svg class="arc" viewBox="0 0 120 22" aria-hidden="true">
        {ARC.map(([x, y, s]) => (
          <path d={SPARK} fill="currentColor" transform={`translate(${x - s / 2} ${y - s / 2}) scale(${s / 24})`} />
        ))}
      </svg>
    )
  }
  <span class="lens" aria-hidden="true">{tier === 'MODE_SPLIT' ? 'Mode-split' : tier === 'UNRANKED' ? 'Unranked' : tier}</span>
  <span class="star-rule" aria-hidden="true"><Sparkle /></span>
  <span class="rack-count">{count} {count === 1 ? 'character' : 'characters'}</span>
</div>
