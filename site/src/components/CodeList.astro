---
// One section of the codes page (clean guide, 2026-11-24): code cards
// for one status. Cards show the code, the reward, and the dates —
// no source names anywhere. Statuses arrive computed from Rust
// (codes.json); this component only formats.
import type { CodeEntry } from '../types/contract/CodeEntry';
import { fmtDate } from '../lib/data';

interface Props {
  entries: CodeEntry[];
  variant: 'active' | 'unconfirmed' | 'expired';
  /** Build instant, for the expired section's 30-day window. */
  now: number;
}
const { entries, variant, now } = Astro.props;

/** "Last checked {date}" from the freshest sighting of the code. */
function lastChecked(entry: CodeEntry): string {
  const lastSeen = [...entry.observations]
    .sort((a, b) => Date.parse(b.seen_at) - Date.parse(a.seen_at))[0]
    .seen_at.slice(0, 10);
  return `Last checked ${fmtDate(lastSeen)}`;
}

const DAY = 86_400_000;
const visible = entries.filter((entry) => {
  if (variant !== 'expired') return true;
  // Expired section shows only the last 30 days.
  const latest = Math.max(
    ...entry.observations.map((o) => Date.parse(o.seen_at)),
  );
  return now - latest <= 30 * DAY;
});
---

<ul class="codes" data-expired-list={variant === 'expired' ? '' : undefined}>
  {
    visible.map((entry) => (
      <li
        class={`code-card code-${variant}`}
        data-panel
        data-exp={
          variant === 'active' && entry.expires_at ? entry.expires_at : undefined
        }
      >
        <span class="coderow">
          <code class="code">{entry.code}</code>
          {
            variant !== 'expired' && (
              <button class="copybtn" type="button" data-copy={entry.code} data-active-only aria-label={`Copy code ${entry.code}`}>
                <span class="copy-label">Copy</span>
              </button>
            )
          }
        </span>
        {variant === 'active' && (
          <>
            <p class="line" data-active-only>
              Reward: {entry.reward.text}
            </p>
            {entry.expires_at && (
              <p class="line" data-exp-line>
                Expires {fmtDate(entry.expires_at.slice(0, 10))}
              </p>
            )}
            <p class="line dim" data-active-only>
              {lastChecked(entry)}
            </p>
          </>
        )}
        {variant === 'unconfirmed' && (
          <p class="line dim">{lastChecked(entry)}</p>
        )}
        {variant === 'expired' && (
          <p class="line dim">
            Last seen {fmtDate(
              new Date(
                Math.max(...entry.observations.map((o) => Date.parse(o.seen_at))),
              )
                .toISOString()
                .slice(0, 10),
            )}
          </p>
        )}
      </li>
    ))
  }
</ul>

<style>
  .codes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 10px;
  }
  .code-card {
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    min-width: 0;
  }
  .code-active {
    border-color: var(--success-rim);
  }
  .code {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    font-size: 16px;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    margin: 0 0 4px -2px;
    border-radius: var(--radius-sm);
    background: var(--chip-fill);
    border: 1px solid var(--chip-rim);
    user-select: all;
    word-break: break-all;
  }
  .code-active .code {
    color: var(--aqua);
  }
  .coderow {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .copybtn {
    flex: none;
    min-height: 32px;
    padding: 0 13px;
    margin-top: 1px;
    border-radius: var(--radius-pill);
    background: var(--chip-fill);
    border: 1px solid var(--chip-rim);
    color: var(--sub);
    font-family: var(--font-sans);
    font-size: var(--text-note);
    font-weight: var(--weight-bold);
    cursor: pointer;
    transition:
      background-color var(--duration-fast),
      color var(--duration-fast);
  }
  .copybtn:hover {
    background: var(--chip-fill-hover);
    color: var(--text);
  }
  .copybtn.copied {
    color: var(--aqua);
    border-color: var(--success-rim);
  }
  .copybtn:focus-visible {
    outline: 2px solid var(--starlight);
    outline-offset: 2px;
  }
  .line {
    margin: 6px 0 0;
    color: var(--text);
    font-size: var(--text-body-sm);
  }
  .line.dim {
    color: var(--sub);
  }
</style>
