---
// The "character file" dossier (plan T3.3 + §B.5 Character page +
// DESIGN.md dossier structure). One component, two places: inside the
// evidence <dialog> on boards and as the body of /c/<slug>/.
// The current investment level follows <html data-level> via CSS, so
// the same static HTML serves the toggle (D-2).
import type { Character } from '../types/contract/Character';
import type { EvidenceRow } from '../types/contract/EvidenceRow';
import type { Level } from '../types/contract/Level';
import {
  LEVELS,
  LEVEL_NAME,
  LABEL_WORD,
  CRITERIA_SHORT,
  NONE_REASON_TEXT,
  NOT_COUNTED_REASON,
  NOTE_SHORT,
  errataById,
  flagSummary,
  fmtDate,
  fmtSpread,
  fmtVal,
  sourceName,
  sourcesById,
  tierDisplay,
  whyText,
} from '../lib/data';
import LabelMark from './LabelMark.astro';
import Medallion from './Medallion.astro';

interface Props {
  character: Character;
  /** Render the name as <h1> (character page) instead of <h2> (dialog). */
  asPage?: boolean;
}
const { character: c, asPage = false } = Astro.props;

interface RowVM {
  name: string;
  url: string;
  date: string;
  kind: string;
  plain: string | null;
  segments: { lvl: Level; text: string }[] | null;
  note: string | null;
  reason: string | null;
  flags: string | null;
  numText: string | null;
  numByLevel: Record<Level, string> | null;
}

function rowVM(row: EvidenceRow, checkOnly: boolean): RowVM {
  const p = row.placement;
  const vm: RowVM = {
    name: sourceName(row.source),
    url: row.page_url,
    date: fmtDate(row.page_date),
    kind: p.kind,
    plain: null,
    segments: null,
    note: row.note ? (NOTE_SHORT[row.note] ?? row.note) : null,
    reason: null,
    flags: flagSummary(row),
    numText: null,
    numByLevel: null,
  };
  if (p.kind === 'single') {
    vm.plain = p.raw;
    vm.numText = p.converted !== null ? fmtVal(p.converted) : null;
  } else if (p.kind === 'modes') {
    vm.plain = `Conquest ${p.conquest ?? '—'} · Rift ${p.rift ?? '—'}`;
    vm.numText = p.converted_overall !== null ? fmtVal(p.converted_overall) : null;
  } else if (p.kind === 'levels') {
    vm.segments = LEVELS.map((lv) => ({
      lvl: lv,
      text: `${LEVEL_NAME[lv]} ${p[lv].raw}`,
    }));
    vm.numByLevel = {
      low: fmtVal(p.low.converted),
      high: fmtVal(p.high.converted),
      max: fmtVal(p.max.converted),
    };
  } else if (p.kind === 'none') {
    vm.reason = NONE_REASON_TEXT[p.reason] ?? p.reason;
  }
  if (checkOnly) {
    vm.reason = NOT_COUNTED_REASON[row.source] ?? 'Not counted';
    if (p.kind === 'none') {
      vm.plain = 'Not listed';
    }
    vm.numText = null;
    vm.numByLevel = null;
  }
  return vm;
}

const votingRows = c.evidence
  .filter((r) => r.role === 'voting')
  .map((r) => rowVM(r, false));
const checkRows = c.evidence
  .filter((r) => r.role === 'check_only')
  .map((r) => rowVM(r, true));

// CP3 debloat: display the short caveat here; the full text is on the
// Rules page (and stays untouched in the data).
const criteria = c.evidence
  .filter((r) => r.role === 'voting' && r.counted)
  .map((r) => ({
    name: sourceName(r.source),
    caveat:
      CRITERIA_SHORT[r.source] ??
      sourcesById.get(r.source)?.criteria_caveat ??
      null,
  }))
  .filter((x) => x.caveat !== null);

const NameTag = asPage ? 'h1' : 'h2';
---

<article class="dossier" data-panel={asPage ? '' : undefined}>
  <div class="dhead">
    <Medallion id={c.id} name={c.name} />
    <div>
      <p class="evkicker">Character file</p>
      <NameTag class="dname">
        {c.name}
        {c.is_new && <span class="newtag">New</span>}
      </NameTag>
    </div>
  </div>

  <p class="summary">
    {
      LEVELS.map((lv, i) => (
        <>
          {i > 0 && '   '}
          <span class="sumseg" data-lvl={lv}>
            {LEVEL_NAME[lv]}: {tierDisplay(c.results[lv].tier)} ·{' '}
            {LABEL_WORD[c.results[lv].label]}
          </span>
        </>
      ))
    }
  </p>

  {
    LEVELS.map((lv) => {
      const r = c.results[lv];
      return (
        <div class={`lvl lvl-${lv}`}>
          <div class="stats">
            <div class="stat">
              <span class="k">Tier</span>
              <span class="v" data-tier={r.tier}>
                {tierDisplay(r.tier)}{' '}
                <small>
                  <LabelMark label={r.label} size={12} /> {LABEL_WORD[r.label]}
                </small>
              </span>
            </div>
            <div class="stat">
              <span class="k">Score</span>
              <span class="v">
                {r.score_display ?? '—'} <small>of 4</small>
              </span>
            </div>
            <div class="stat">
              <span class="k">Lists · gap</span>
              <span class="v">
                {r.coverage} <small>lists · gap {fmtSpread(r.spread)}</small>
              </span>
            </div>
          </div>
        </div>
      );
    })
  }

  <div class="levels" role="group" aria-label="Tier by investment">
    {
      LEVELS.map((lv) => (
        <span class="lvlchip" data-lvl={lv}>
          {LEVEL_NAME[lv]} · {tierDisplay(c.results[lv].tier)}
        </span>
      ))
    }
  </div>

  {
    LEVELS.map((lv) => (
      <div class={`lvl lvl-${lv}`}>
        <p class="why">
          <b>Why {LABEL_WORD[c.results[lv].label]}:</b> {whyText(c, lv)}
        </p>
      </div>
    ))
  }

  <h3 class="seclabel">What each list says</h3>
  {
    votingRows.map((row) => (
      <div class="evrow">
        <span class="src">
          <a href={row.url}>{row.name}</a>
        </span>
        <span class="plc">
          {row.segments ? (
            row.segments.map((seg, i) => (
              <>
                {i > 0 && ' · '}
                <span class="seg" data-lvl={seg.lvl}>
                  {seg.text}
                </span>
              </>
            ))
          ) : row.plain ? (
            row.plain
          ) : null}
          {row.reason && <span class="reason">{row.reason}</span>}
          {row.flags && <span class="note">{row.flags}</span>}
          {row.note && <span class="note">{row.note}</span>}
        </span>
        <span class="num">
          {row.numByLevel ? (
            LEVELS.map((lv) => (
              <span class={`lvl lvl-${lv}`}>{row.numByLevel![lv]}</span>
            ))
          ) : row.numText ? (
            row.numText
          ) : (
            '—'
          )}
        </span>
        <span class="dt">{row.date}</span>
      </div>
    ))
  }

  {
    criteria.length > 0 && (
      <>
        <h3 class="seclabel">How each list rates</h3>
        {criteria.map((x) => (
          <p class="criteria">
            <b>{x.name}:</b> {x.caveat}
          </p>
        ))}
      </>
    )
  }

  {
    checkRows.length > 0 && (
      <>
        <h3 class="seclabel">Not counted (shown for context)</h3>
        {checkRows.map((row) => (
          <div class="evrow">
            <span class="src">
              <a href={row.url}>{row.name}</a>
            </span>
            <span class="plc">
              {row.plain}
              {row.reason && <span class="reason">{row.reason}</span>}
            </span>
            <span class="num">—</span>
            <span class="dt">{row.date}</span>
          </div>
        ))}
      </>
    )
  }

  <p class="modes">
    Conquest {tierDisplay(c.modes.conquest.tier as never)} · Rift{' '}
    {tierDisplay(c.modes.rift.tier as never)} (Pocket Gamer only)
  </p>

  {
    c.errata.length > 0 && (
      <>
        <h3 class="seclabel">Corrections for this character</h3>
        {c.errata.map((id) => {
          const entry = errataById.get(id);
          return (
            <p class="criteria">
              {entry ? `${fmtDate(entry.found_at)}: ${entry.what}` : id}
            </p>
          );
        })}
      </>
    )
  }

  <p class="howlink"><a href="/rules/">How we score →</a></p>
</article>

<style>
  .dossier {
    position: relative;
    border-radius: var(--radius-xl);
    padding: 26px var(--space-panel) 22px;
  }
  .dhead {
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 4px 0 14px;
    --med: var(--med-dossier);
  }
  .dhead > div {
    min-width: 0;
  }
  .evkicker {
    font-size: var(--text-kicker);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--lavender);
    font-weight: var(--weight-bold);
    margin: 0;
  }
  .dname {
    font-family: var(--font-display);
    font-size: var(--text-dossier-name);
    margin: 4px 0 0;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
    text-shadow: 0 0 20px var(--glow);
    line-height: 1.05;
  }
  .newtag {
    display: inline-block;
    font-family: var(--font-sans);
    text-shadow: none;
    font-size: var(--text-pill);
    font-weight: var(--weight-bold);
    letter-spacing: 0.02em;
    background: var(--pill);
    border: 1px solid var(--pill-rim);
    color: var(--text);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    vertical-align: middle;
    margin-left: 10px;
  }
  .summary {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 0 0 14px;
    white-space: pre-wrap;
  }
  .sumseg {
    white-space: nowrap;
  }
  :global([data-level="low"]) .sumseg[data-lvl="low"],
  :global([data-level="high"]) .sumseg[data-lvl="high"],
  :global([data-level="max"]) .sumseg[data-lvl="max"] {
    color: var(--text);
    font-weight: var(--weight-bold);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-grid-gap);
  }
  .stat {
    background: var(--chip-fill);
    border: 1px solid var(--chip-rim);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    min-width: 0;
  }
  .stat .k {
    display: block;
    font-size: var(--text-stat-key);
    color: var(--sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--weight-bold);
  }
  .stat .v {
    display: block;
    font-size: var(--stat-value-size);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  .stat .v[data-tier="S"] { color: var(--tier-s); }
  .stat .v[data-tier="A"] { color: var(--tier-a); }
  .stat .v[data-tier="B"] { color: var(--tier-b); }
  .stat .v[data-tier="C"] { color: var(--tier-c); }
  .stat .v[data-tier="D"] { color: var(--tier-d); }
  .stat .v[data-tier="MODE_SPLIT"] { color: var(--tier-mode-split); }
  .stat .v small {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: var(--sub);
    font-weight: var(--weight-semibold);
    letter-spacing: 0;
  }
  .levels {
    display: flex;
    gap: 6px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .lvlchip {
    border: 1px solid var(--chip-rim);
    background: var(--chip-fill);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    font-size: var(--text-note);
    color: var(--sub);
    transition:
      background-color var(--duration-fast),
      color var(--duration-fast);
  }
  :global([data-level="low"]) .lvlchip[data-lvl="low"],
  :global([data-level="high"]) .lvlchip[data-lvl="high"],
  :global([data-level="max"]) .lvlchip[data-lvl="max"] {
    background: var(--lavender);
    border-color: var(--lavender);
    color: var(--on-lavender);
    font-weight: var(--weight-bold);
  }
  .why {
    margin: 16px 0 0;
    font-size: var(--text-body-sm);
    background: var(--callout-fill);
    border: 1px solid var(--callout-rim);
    border-radius: var(--radius-md);
    padding: 13px 15px;
  }
  .why b {
    color: var(--rose);
  }
  .seclabel {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sub);
    margin: 26px 0 6px;
    font-weight: var(--weight-bold);
  }
  .evrow {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--hairline);
  }
  .evrow .src {
    flex: 0 0 104px;
    font-weight: var(--weight-bold);
    font-size: var(--text-body-sm);
  }
  .evrow .src a {
    color: var(--text);
    text-decoration: none;
  }
  .evrow .src a:hover {
    text-decoration: underline;
  }
  .evrow .plc {
    flex: 1;
    font-size: var(--text-body-sm);
    min-width: 0;
  }
  .evrow .plc .note,
  .evrow .plc .reason {
    display: block;
    color: var(--sub);
    font-size: 12.5px;
    margin-top: 2px;
  }
  :global([data-level="low"]) .seg[data-lvl="low"],
  :global([data-level="high"]) .seg[data-lvl="high"],
  :global([data-level="max"]) .seg[data-lvl="max"] {
    font-weight: var(--weight-bold);
    color: var(--starlight);
  }
  .evrow .num {
    flex: 0 0 auto;
    font-weight: var(--weight-bold);
    font-size: var(--text-base);
    font-variant-numeric: tabular-nums;
  }
  .evrow .dt {
    flex: 0 0 auto;
    color: var(--sub);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 520px) {
    .dossier {
      padding: 22px 16px 18px;
    }
    .evrow {
      flex-wrap: wrap;
      gap: 4px 12px;
    }
    .evrow .src {
      flex-basis: 100%;
    }
    .stat {
      padding: 10px 11px;
    }
    .stat .v {
      font-size: 19px;
    }
  }
  .criteria {
    color: var(--sub);
    font-size: var(--text-body-sm);
    margin: 6px 0 0;
  }
  .criteria b {
    color: var(--text);
  }
  .modes {
    margin: 18px 0 0;
    font-size: var(--text-body-sm);
  }
  .howlink {
    margin: 14px 0 0;
    font-size: var(--text-body-sm);
  }
  .howlink a {
    color: var(--link);
    font-weight: var(--weight-semibold);
  }
</style>
