---
// Pocket Gamer's per-mode board (plan T3.4): racks S–C plus the
// "Not ranked by mode" rack, sorted by name. Chips carry the small
// Overall-at-Low line and open the same evidence dialog.
// Same rack styles as TierBoard (global.css).
import type { ModeBoard as ModeBoardData } from '../types/contract/ModeBoard';
import { charactersById } from '../lib/data';
import CharacterChip from './CharacterChip.astro';
import TierLens from './TierLens.astro';

interface Props {
  board: ModeBoardData;
}
const { board } = Astro.props;

const ROWS: ('S' | 'A' | 'B' | 'C')[] = ['S', 'A', 'B', 'C'];
const byName = (ids: string[]) =>
  [...ids].sort((a, b) =>
    charactersById.get(a)!.name.localeCompare(charactersById.get(b)!.name),
  );
---

<div class="tierboard">
  {
    ROWS.filter((key) => board[key].length > 0).map((key) => (
      <section class="rack" data-tier={key} data-glass>
        <h2 class="sr-only">Tier {key}</h2>
        <TierLens tier={key} count={board[key].length} />
        <div class="cards">
          {byName(board[key]).map((id) => {
            const c = charactersById.get(id)!;
            return <CharacterChip character={c} result={c.results.low} overallLine />;
          })}
        </div>
      </section>
    ))
  }
  {
    board.UNRANKED.length > 0 && (
      <>
        <h2 class="rack-title">Not ranked by mode</h2>
        <section class="rack" data-tier="UNRANKED" data-glass>
          <TierLens tier="UNRANKED" count={board.UNRANKED.length} />
          <div class="cards">
            {byName(board.UNRANKED).map((id) => {
              const c = charactersById.get(id)!;
              return <CharacterChip character={c} result={c.results.low} overallLine />;
            })}
          </div>
        </section>
      </>
    )
  }
</div>
