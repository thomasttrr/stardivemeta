---
// The one tier board (clean guide, 2026-11-24): an open section per
// tier — a tinted lens with the tier letter and count, then the chip
// grid (DESIGN.md "Tier rack"). Empty rows hide. Styles: global.css.
import { charactersById, cleanBoard } from '../lib/data';
import CharacterChip from './CharacterChip.astro';
import TierLens from './TierLens.astro';

const ROWS = ['S', 'A', 'B', 'C', 'D', 'UNRANKED'] as const;
const heading = (k: string) => (k === 'UNRANKED' ? 'Not ranked yet' : `Tier ${k}`);
---

<div class="tierboard">
  {
    ROWS.filter((key) => cleanBoard[key].length > 0).map((key, rackIdx) => (
      <section class="rack" data-tier={key}>
        <h2 class="sr-only">{heading(key)}</h2>
        <TierLens tier={key} count={cleanBoard[key].length} />
        <div class="cards">
          {cleanBoard[key].map((id) => {
            const c = charactersById.get(id)!;
            return (
              <CharacterChip
                character={c}
                tier={key === 'UNRANKED' ? 'not ranked yet' : key}
                eager={rackIdx === 0}
              />
            );
          })}
        </div>
      </section>
    ))
  }
</div>
