---
// One investment level's tier board (plan T3.2): a rack per tier —
// badge rail + card grid (DESIGN.md "Tier rack"). Empty rows hide.
import type { Character } from '../types/contract/Character';
import type { Level } from '../types/contract/Level';
import type { TierBoard as TierBoardData } from '../types/contract/TierBoard';
import { charactersById } from '../lib/data';
import CharacterChip from './CharacterChip.astro';

interface Props {
  board: TierBoardData;
  level: Level;
  /** Character map to resolve chips against. Defaults to the live
   * data; history pages pass the snapshot's frozen characters (T4.3). */
  characters?: Map<string, Character>;
}
const { board, level, characters = charactersById } = Astro.props;

const ROWS: { key: keyof TierBoardData; letter: string }[] = [
  { key: 'S', letter: 'S' },
  { key: 'A', letter: 'A' },
  { key: 'B', letter: 'B' },
  { key: 'C', letter: 'C' },
  { key: 'D', letter: 'D' },
  { key: 'MODE_SPLIT', letter: '⇄' },
  { key: 'UNRANKED', letter: '—' },
];
---

<div class="board">
  {
    ROWS.filter((row) => board[row.key].length > 0).map((row) => (
      <section class="rack">
        <h2 class="sr-only">Tier {row.key === 'MODE_SPLIT' ? 'mode-split' : row.key}</h2>
        <div class="badge" data-tier={row.key}>
          <span class="t" aria-hidden="true">
            {row.letter}
          </span>
          <span class="n">
            {board[row.key].length} {board[row.key].length === 1 ? 'char' : 'chars'}
          </span>
        </div>
        <div class="cards">
          {board[row.key].map((id) => {
            const c = characters.get(id)!;
            return <CharacterChip character={c} result={c.results[level]} />;
          })}
        </div>
      </section>
    ))
  }
</div>

<style>
  .rack {
    display: flex;
    gap: var(--space-rack-gap);
    margin-top: var(--space-section);
  }
  .badge {
    flex: 0 0 var(--badge-width);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    padding: 10px 2px;
    color: var(--on-tier);
    background: var(--grey);
  }
  .badge .t {
    font-size: var(--badge-tier-size);
    font-weight: var(--weight-black);
    line-height: 1;
  }
  .badge .n {
    font-size: var(--text-badge-count);
    font-weight: var(--weight-bold);
  }
  .badge[data-tier="S"] {
    background: var(--tier-s);
  }
  .badge[data-tier="A"] {
    background: var(--tier-a);
  }
  .badge[data-tier="B"] {
    background: var(--tier-b);
  }
  .badge[data-tier="C"] {
    background: var(--tier-c);
  }
  .badge[data-tier="D"] {
    background: var(--tier-d);
  }
  .badge[data-tier="MODE_SPLIT"] {
    background: var(--tier-mode-split);
  }
  .badge[data-tier="MODE_SPLIT"] .t {
    font-size: var(--badge-tier-size-split);
  }
  .cards {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--card-min-width), 1fr));
    gap: var(--space-grid-gap);
    align-content: start;
  }
</style>
