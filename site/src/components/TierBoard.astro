---
// One investment level's tier board (plan T3.2): an open section per tier —
// a tinted lens with the tier letter and count, then the chip grid
// (DESIGN.md "Tier rack"). Empty rows hide. Styles: global.css.
import type { Character } from '../types/contract/Character';
import type { Level } from '../types/contract/Level';
import type { TierBoard as TierBoardData } from '../types/contract/TierBoard';
import { charactersById } from '../lib/data';
import CharacterChip from './CharacterChip.astro';
import TierLens from './TierLens.astro';

interface Props {
  board: TierBoardData;
  level: Level;
  /** Character map to resolve chips against. Defaults to the live
   * data; history pages pass the snapshot's frozen characters (T4.3). */
  characters?: Map<string, Character>;
  /** Mark each chip with the emitted disagreement flag so the home
   * filter can show and hide without calculating anything. */
  markDisagree?: boolean;
}
const { board, level, characters = charactersById, markDisagree = false } = Astro.props;

const ROWS: (keyof TierBoardData)[] = ['S', 'A', 'B', 'C', 'D', 'MODE_SPLIT', 'UNRANKED'];
const heading = (k: keyof TierBoardData) =>
  k === 'MODE_SPLIT' ? 'mode-split' : k === 'UNRANKED' ? 'unranked' : k;
---

<div class="tierboard">
  {
    ROWS.filter((key) => board[key].length > 0).map((key, rackIdx) => (
      <section class="rack" data-tier={key}>
        <h2 class="sr-only">Tier {heading(key)}</h2>
        <TierLens
          tier={key}
          count={board[key].length}
          disagreeCount={
            markDisagree
              ? board[key].filter((id) => characters.get(id)!.results[level].sources_disagree).length
              : undefined
          }
        />
        <div class="cards">
          {board[key].map((id) => {
            const c = characters.get(id)!;
            return (
              <CharacterChip
                character={c}
                result={c.results[level]}
                eager={rackIdx === 0}
                disagree={markDisagree ? c.results[level].sources_disagree : undefined}
              />
            );
          })}
        </div>
      </section>
    ))
  }
</div>
