---
// A character portrait in the ringed circle (DESIGN.md "Medallion").
// Decorative: the name always sits beside it, so alt is empty. With no
// portrait on file it shows the name's first letter instead; while a
// portrait is still loading the same letter sits behind the image, so
// the ring never shows as an empty disc.
// Size comes from --med on an ancestor (tier group or dossier).
import { portraitSrc } from '../lib/portraits';

interface Props {
  id: string;
  name: string;
  /** Load eagerly (above-the-fold portraits); everything else stays
   * lazy so the first paint is not held up by off-screen faces. */
  eager?: boolean;
}
const { id, name, eager = false } = Astro.props;
const src = portraitSrc(id);
---

<span class="med" aria-hidden="true">
  {
    src ? (
      <>
        <span class="med-letter">{name.charAt(0)}</span>
        <img src={src} alt="" width="320" height="320" loading={eager ? 'eager' : 'lazy'} decoding="async" />
      </>
    ) : (
      name.charAt(0)
    )
  }
</span>
